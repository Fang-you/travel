<view class="menu-item" bindtap="onTap">
  <view class="menu-left">
    <view class="icon-wrapper" style="background-color: {{bgColor}}">
      <image class="icon" src="{{icon}}" mode="aspectFit"></image>
    </view>
    <text class="title">{{title}}</text>
    <view class="badge" wx:if="{{badge > 0}}">{{badge}}</view>
  </view>
  <image class="arrow" src="/images/icon_arrow_right.png" mode="aspectFit"></image>
</view>
