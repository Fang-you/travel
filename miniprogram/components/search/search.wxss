.search-container {
  padding: 24rpx 32rpx;
  background-color: #ffffff;
}

.search-box {
  position: relative;
  width: 100%;
  height: 88rpx;
  background-color: rgba(241, 245, 249, 0.8);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.search-box:focus-within {
  background-color: #ffffff;
  border-color: #3b82f6;
  box-shadow: 0 0 0 4rpx rgba(59, 130, 246, 0.1);
}

.search-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #1e293b;
}

.placeholder {
  color: #94a3b8;
  font-size: 28rpx;
}
