<view class="card">
  <view class="card-header">
    <text class="order-id">订单号: {{orderId}}</text>
    <text class="order-status" style="color: {{statusColor}}">{{statusText}}</text>
  </view>
  
  <view class="card-body" style="opacity: {{opacity}}">
    <image class="card-image {{status === 'completed' ? 'grayscale' : ''}}" src="{{image}}" mode="aspectFill"></image>
    <view class="card-info">
      <text class="card-title">{{title}}</text>
      <text class="card-date">出行日期: {{date}}</text>
      <view class="card-price">
        <text class="price-symbol" style="color: {{priceColor}}">¥</text>
        <text class="price-value" style="color: {{priceColor}}">{{price}}</text>
      </view>
    </view>
  </view>
  
  <view class="card-footer">
    <block wx:if="{{status === 'pending'}}">
      <view class="btn btn-outline" bindtap="onCancel">取消订单</view>
      <view class="btn btn-primary" bindtap="onPay">去支付</view>
    </block>
    <block wx:elif="{{status === 'completed'}}">
      <view class="btn btn-outline" bindtap="onDetail">查看详情</view>
      <view class="btn btn-dark" bindtap="onReorder">再来一单</view>
    </block>
    <block wx:elif="{{status === 'cancelled'}}">
      <view class="btn btn-outline-gray" bindtap="onDelete">删除订单</view>
      <view class="btn btn-outline-dark" bindtap="onActivity">查看活动</view>
    </block>
  </view>
</view>
