.card {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #f3f4f6;
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.order-id {
  font-size: 24rpx;
  color: #9ca3af;
}

.order-status {
  font-size: 28rpx;
  font-weight: 500;
}

.card-body {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.card-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.card-image.grayscale {
  filter: grayscale(20%);
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-date {
  font-size: 24rpx;
  color: #6b7280;
}

.card-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-symbol {
  font-size: 24rpx;
}

.price-value {
  font-size: 36rpx;
  font-weight: bold;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f9fafb;
}

.btn {
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.btn-outline {
  border: 2rpx solid #e5e7eb;
  color: #4b5563;
  background-color: transparent;
}

.btn-outline-gray {
  border: 2rpx solid #e5e7eb;
  color: #9ca3af;
  background-color: transparent;
}

.btn-outline-dark {
  border: 2rpx solid #1f2937;
  color: #1f2937;
  background-color: transparent;
}

.btn-primary {
  background-color: #2563eb;
  color: #ffffff;
  box-shadow: 0 8rpx 16rpx rgba(37, 99, 235, 0.2);
}

.btn-dark {
  background-color: #1f2937;
  color: #ffffff;
}
