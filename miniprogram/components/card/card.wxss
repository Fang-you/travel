.card {
  background-color: #ffffff;
  padding: 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #f1f5f9;
  display: flex;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.card-image-wrapper {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  flex-shrink: 0;
}

.card-image {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.card-duration {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background-color: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8rpx);
  color: #ffffff;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.card-info {
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-desc {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.card-stats {
  display: flex;
  flex-direction: column;
}

.card-count {
  font-size: 20rpx;
  color: #94a3b8;
}

.card-price {
  color: #f43f5e;
  font-weight: bold;
}

.price-symbol {
  font-size: 24rpx;
}

.price-value {
  font-size: 36rpx;
}

.card-btn {
  background-color: #2563eb;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
}
