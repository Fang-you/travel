.page {
  min-height: 100vh;
  background-color: #f9fafb;
}

/* 顶部品牌区域 */
.brand-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx;
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
}

.brand-logo {
  width: 160rpx;
  height: 160rpx;
  background-color: #ffffff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
}

.logo-icon {
  width: 100rpx;
  height: 100rpx;
}

.brand-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.brand-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 数据统计 */
.stats-section {
  display: flex;
  justify-content: space-around;
  background-color: #ffffff;
  padding: 40rpx 32rpx;
  margin: -40rpx 32rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #2563eb;
}

.stat-label {
  font-size: 22rpx;
  color: #6b7280;
}

/* 通用区块 */
.section {
  background-color: #ffffff;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  border-radius: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.title-bar {
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #2563eb 0%, #3b82f6 100%);
  border-radius: 4rpx;
}

.section-title text {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
}

/* 公司简介 */
.intro-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.intro-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.intro-label {
  font-size: 24rpx;
  color: #9ca3af;
}

.intro-value {
  font-size: 28rpx;
  color: #1f2937;
  line-height: 1.6;
}

/* 核心价值观 */
.values-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.value-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 16rpx;
  background-color: #f9fafb;
  border-radius: 20rpx;
  text-align: center;
}

.value-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 16rpx;
}

.value-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.value-desc {
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.4;
}

/* 发展历程 */
.timeline {
  position: relative;
  padding-left: 32rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 16rpx;
  bottom: 16rpx;
  width: 4rpx;
  background: linear-gradient(180deg, #2563eb 0%, #93c5fd 100%);
  border-radius: 2rpx;
}

.timeline-item {
  position: relative;
  padding-bottom: 32rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -28rpx;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: #2563eb;
  border-radius: 50%;
  border: 4rpx solid #dbeafe;
}

.timeline-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.timeline-date {
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 600;
}

.timeline-event {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.5;
}

/* 联系我们 */
.contact-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.contact-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.contact-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.contact-text {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.5;
}

/* 底部版权 */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  gap: 8rpx;
}

.copyright {
  font-size: 22rpx;
  color: #9ca3af;
}

.icp {
  font-size: 20rpx;
  color: #d1d5db;
}
