.page {
  height: 100vh;
  background-color: #f9fafb;
  display: flex;
  flex-direction: column;
}

/* 标题栏 */
.header {
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
}

/* 分类标签 */
.tabs {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background-color: #ffffff;
  border-bottom: 2rpx solid #f3f4f6;
}

.tab-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}

.tab-text {
  font-size: 28rpx;
  color: #6b7280;
  transition: color 0.2s ease;
}

.tab-item.active .tab-text {
  color: #2563eb;
  font-weight: 500;
}

.tab-indicator {
  position: absolute;
  bottom: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  background-color: #2563eb;
  border-radius: 4rpx;
}

/* 内容区 */
.content {
  flex: 1;
  height: 0;
}

.order-list {
  padding: 24rpx 32rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}
