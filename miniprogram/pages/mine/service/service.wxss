.container {
  padding: 32rpx;
  background-color: #f9fafb;
  min-height: 100vh;
}

/* 客服头部 */
.service-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  border-radius: 24rpx;
  margin-bottom: 32rpx;
}

.service-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #ffffff;
  margin-bottom: 16rpx;
}

.service-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.service-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 区块标题 */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 24rpx;
}

/* 联系方式区块 */
.contact-section {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.contact-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f3f4f6;
}

.contact-card:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.contact-card:first-of-type {
  padding-top: 0;
}

.contact-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.contact-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-icon-box.phone {
  background-color: #ecfdf5;
}

.contact-icon-box.wechat {
  background-color: #f0fdf4;
}

.contact-icon-box.online {
  background-color: #eff6ff;
}

.contact-icon {
  width: 40rpx;
  height: 40rpx;
}

.contact-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.contact-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.contact-value {
  font-size: 24rpx;
  color: #6b7280;
}

.contact-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.contact-action text {
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 500;
}

.arrow-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.5;
}

/* AI智能客服区块 */
.ai-section {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.ai-section .section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.ai-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 快捷问题 */
.quick-questions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.quick-item {
  padding: 12rpx 24rpx;
  background-color: #eff6ff;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #2563eb;
  border: 2rpx solid #dbeafe;
}

.quick-item:active {
  background-color: #dbeafe;
}

/* 聊天区域 */
.chat-area {
  height: 480rpx;
  background-color: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.chat-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.chat-item {
  display: flex;
  gap: 16rpx;
  max-width: 85%;
}

.chat-item.user {
  flex-direction: row-reverse;
  align-self: flex-end;
}

.chat-item.ai {
  align-self: flex-start;
}

.chat-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.chat-bubble {
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  max-width: 100%;
}

.chat-item.ai .chat-bubble {
  background-color: #ffffff;
  border-top-left-radius: 8rpx;
}

.chat-item.user .chat-bubble {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  border-top-right-radius: 8rpx;
}

.chat-item.ai .chat-text {
  color: #1f2937;
  font-size: 26rpx;
  line-height: 1.6;
}

.chat-item.user .chat-text {
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 打字动画 */
.chat-bubble.typing {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 32rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #9ca3af;
  border-radius: 50%;
  animation: typing 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(1) {
  animation-delay: 0s;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background-color: #f3f4f6;
  border-radius: 48rpx;
  padding: 8rpx 8rpx 8rpx 32rpx;
}

.chat-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
  height: 72rpx;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.send-btn.active {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
}

.send-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 服务承诺 */
.promise-section {
  display: flex;
  justify-content: space-around;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
}

.promise-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.promise-icon {
  width: 48rpx;
  height: 48rpx;
}

.promise-item text {
  font-size: 24rpx;
  color: #6b7280;
}
