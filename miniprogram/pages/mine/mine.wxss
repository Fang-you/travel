.page {
  height: 100vh;
  background-color: #f9fafb;
  display: flex;
  flex-direction: column;
}

/* 头部区域 */
.header {
  background: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
  padding: 80rpx 48rpx 100rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.avatar-wrapper {
  position: relative;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
}

.crown-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: #facc15;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.crown-icon {
  width: 24rpx;
  height: 24rpx;
}

.user-detail {
  flex: 1;
}

.user-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
  margin-bottom: 16rpx;
}

.user-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}

.tag text {
  font-size: 20rpx;
  color: #ffffff;
}

.tag-icon {
  width: 24rpx;
  height: 24rpx;
}

/* 内容区域 */
.content {
  flex: 1;
  height: 0;
  margin-top: -48rpx;
  background-color: #f9fafb;
  border-radius: 48rpx 48rpx 0 0;
  padding: 48rpx 32rpx;
}

/* 订单区域 */
.order-section {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1f2937;
}

.view-all {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.view-all text {
  font-size: 24rpx;
  color: #9ca3af;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.5;
}

.order-shortcuts {
  display: flex;
  justify-content: space-around;
}

.shortcut-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.shortcut-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shortcut-icon image {
  width: 48rpx;
  height: 48rpx;
}

.shortcut-name {
  font-size: 22rpx;
  color: #4b5563;
}

/* 菜单区域 */
.menu-section {
  margin-bottom: 32rpx;
}

/* 推广卡片 */
.promo-card {
  background: linear-gradient(135deg, #2dd4bf 0%, #10b981 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
  height: 160rpx;
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
}

.promo-content {
  position: relative;
  z-index: 1;
}

.promo-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.promo-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.promo-bg {
  position: absolute;
  right: -32rpx;
  bottom: -32rpx;
  width: 192rpx;
  height: 192rpx;
  opacity: 0.2;
}
