.page {
  min-height: 100vh;
  background-color: #f9fafb;
}

/* 顶部轮播图 */
.banner-swiper {
  width: 100%;
  height: 480rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 商品基本信息 */
.product-info {
  background-color: #ffffff;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 28rpx;
  color: #f43f5e;
  font-weight: bold;
}

.price-value {
  font-size: 56rpx;
  color: #f43f5e;
  font-weight: bold;
}

.price-unit {
  font-size: 24rpx;
  color: #9ca3af;
  margin-left: 4rpx;
}

.original-price {
  font-size: 28rpx;
  color: #d1d5db;
  text-decoration: line-through;
}

.product-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
  display: block;
  margin-bottom: 8rpx;
}

.product-desc {
  font-size: 26rpx;
  color: #6b7280;
  display: block;
  margin-bottom: 24rpx;
}

.meta-row {
  display: flex;
  gap: 32rpx;
  flex-wrap: wrap;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.meta-item.rating {
  color: #f59e0b;
}

.meta-icon {
  width: 28rpx;
  height: 28rpx;
}

.review-count {
  color: #9ca3af;
  margin-left: 4rpx;
}

/* 通用区块 */
.section {
  background-color: #ffffff;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.title-bar {
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #2563eb 0%, #3b82f6 100%);
  border-radius: 4rpx;
}

.section-title text {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
}

/* 产品亮点 */
.highlights-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.highlight-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  background-color: #f9fafb;
  border-radius: 16rpx;
}

.highlight-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.highlight-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.highlight-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.highlight-desc {
  font-size: 22rpx;
  color: #6b7280;
}

/* 行程安排 */
.itinerary-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.itinerary-item {
  display: flex;
  gap: 24rpx;
}

.itinerary-day {
  width: 100rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.itinerary-content {
  flex: 1;
  padding-bottom: 24rpx;
  border-bottom: 2rpx dashed #e5e7eb;
}

.itinerary-item:last-child .itinerary-content {
  border-bottom: none;
  padding-bottom: 0;
}

.itinerary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  display: block;
  margin-bottom: 8rpx;
}

.itinerary-desc {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}

/* 费用说明 */
.fee-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.fee-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.fee-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #4b5563;
}

.fee-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.fee-tag {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.fee-tag.included {
  background-color: #ecfdf5;
  color: #059669;
}

.fee-tag.excluded {
  background-color: #fef2f2;
  color: #dc2626;
}

/* 用户保障 */
.guarantee-section {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 32rpx;
}

.guarantee-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.guarantee-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 底部占位 */
.footer-placeholder {
  height: 160rpx;
}

/* 底部操作栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 140rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.footer-left {
  display: flex;
  gap: 48rpx;
}

.footer-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.action-icon {
  width: 44rpx;
  height: 44rpx;
}

.footer-action text {
  font-size: 20rpx;
  color: #6b7280;
}

.buy-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%);
  color: #ffffff;
  padding: 24rpx 48rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(244, 63, 94, 0.3);
}

.buy-price {
  font-size: 32rpx;
  font-weight: bold;
}

.buy-text {
  font-size: 28rpx;
  font-weight: 500;
}
